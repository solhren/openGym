# Neither target embeds food data or an AI provider runtime.
ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE} AS base
WORKDIR /app/api
RUN node -e 'if(parseInt(process.versions.node)!==22)process.exit(1)' \
 && apk add --no-cache flock
COPY api/package.json api/package-lock.json ./
RUN npm ci --omit=dev --omit=optional --ignore-scripts && npm cache clean --force
COPY api/ ./
COPY LICENSE NOTICE.md /app/
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
ENV NODE_ENV=production
USER 1000:1000
CMD ["node", "server.js"]

FROM base AS catalogue
USER root
RUN apk add --no-cache python3 \
 && python3 -c "import sqlite3; c=sqlite3.connect(':memory:'); c.execute('CREATE VIRTUAL TABLE f USING fts5(name)')" \
 && printf '%s\n' '{"type":"module"}' > /app/package.json
COPY scripts/nutrition-local-catalog/ /app/scripts/nutrition-local-catalog/
COPY frontend/src/lib/nutrition/ /app/frontend/src/lib/nutrition/
COPY scripts/self-hosting/health.mjs /app/scripts/self-hosting/health.mjs
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
USER 1000:1000

# Existing installations keep the smaller personal-foods-only target by default.
FROM base AS default
