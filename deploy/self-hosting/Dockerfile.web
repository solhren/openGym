ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:alpine
FROM ${NODE_IMAGE} AS build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY api/coach/core/ /app/api/coach/core/
COPY api/nutrition/core/ /app/api/nutrition/core/
COPY api/shared/ /app/api/shared/
COPY frontend/ ./
# No remote OFF fallback, even when a catalogue is absent or unavailable.
ENV VITE_NUTRITION_LOCAL_V1=1 VITE_OPENGYM_MANAGED_WEB=1
ARG APP_BUILD
RUN NODE_OPTIONS=--max-old-space-size=512 APP_BUILD="$APP_BUILD" npm run build
FROM ${NGINX_IMAGE}
ARG NGINX_CONFIG=nginx.conf
COPY deploy/self-hosting/${NGINX_CONFIG} /etc/nginx/nginx.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY catalogue/media/ /usr/share/nginx/html/exercise-media/
COPY LICENSE NOTICE.md /usr/share/nginx/html/legal/
USER 101:101
ENTRYPOINT ["nginx", "-c", "/etc/nginx/nginx.conf", "-g", "daemon off;"]
