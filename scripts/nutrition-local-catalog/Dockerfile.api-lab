# ISOLATED VALIDATION IMAGE, not the production API Dockerfile.
FROM node:22-alpine
RUN apk add --no-cache python3 flock \
 && python3 -c "import sqlite3; c=sqlite3.connect(':memory:'); c.execute('CREATE VIRTUAL TABLE f USING fts5(name)')"
WORKDIR /app/api
COPY api/package.json api/package-lock.json ./
RUN npm ci --omit=optional --ignore-scripts
COPY api/ ./
COPY frontend/src/lib/nutrition/catalog/normalize.js /app/frontend/src/lib/nutrition/catalog/normalize.js
COPY frontend/src/lib/nutrition/catalog/local-product.js frontend/src/lib/nutrition/catalog/identity.js /app/frontend/src/lib/nutrition/catalog/
COPY frontend/src/lib/nutrition/validate.js frontend/src/lib/nutrition/persistence-contract.js /app/frontend/src/lib/nutrition/
COPY scripts/nutrition-local-catalog/catalog.py scripts/nutrition-local-catalog/fuzzy.py scripts/nutrition-local-catalog/worker.py scripts/nutrition-local-catalog/worker-client.mjs scripts/nutrition-local-catalog/worker-smoke.mjs /app/scripts/nutrition-local-catalog/
COPY scripts/nutrition-local-catalog/wger-generation.py scripts/nutrition-local-catalog/wger_sqlite_loader.py scripts/nutrition-local-catalog/wger-complement.py scripts/nutrition-local-catalog/wger-v1-reader.py scripts/nutrition-local-catalog/wger-worker-client.mjs scripts/nutrition-local-catalog/wger-api-adapter.mjs /app/scripts/nutrition-local-catalog/
COPY scripts/nutrition-local-catalog/wger-off-reference.py scripts/nutrition-local-catalog/off-reference-overlay.py scripts/nutrition-local-catalog/off-overlay-audit.py /app/scripts/nutrition-local-catalog/
RUN mkdir -p /app/scripts/nutrition-local-catalog/artifacts/public-v3-cache \
 && printf '%s\n' '{"type":"module"}' > /app/package.json
USER 65534:65534
ENV NODE_ENV=development PORT=3002 DATA_DIR=/tmp/opengym-api-lab ORIGIN=http://localhost:8080 NUTRITION_LOCAL_CATALOG=1 NUTRITION_LOCAL_CATALOG_WORKSPACE=trial
# Bind intentionally remains container-loopback; test with docker exec/network none.
CMD ["node", "server.js"]
