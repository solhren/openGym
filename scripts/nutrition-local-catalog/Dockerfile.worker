# Development-only image. Repository-root context, explicit file; no API server,
# npm, personal-data volume, cron, route or production Dockerfile alteration.
FROM node:22-alpine
RUN apk add --no-cache python3 \
 && python3 -c "import sqlite3; c=sqlite3.connect(':memory:'); c.execute('CREATE VIRTUAL TABLE check_fts USING fts5(name)'); c.close()"
WORKDIR /app
COPY scripts/nutrition-local-catalog/catalog.py scripts/nutrition-local-catalog/fuzzy.py scripts/nutrition-local-catalog/worker.py scripts/nutrition-local-catalog/worker-client.mjs scripts/nutrition-local-catalog/worker-benchmark.mjs ./scripts/nutrition-local-catalog/
COPY scripts/nutrition-local-catalog/worker-smoke.mjs ./scripts/nutrition-local-catalog/
# The prototype supervisor reuses the existing bounded validator/error type.
# A future runtime-neutral shared module can reduce these source-only copies.
COPY frontend/src/lib/nutrition/catalog/normalize.js ./frontend/src/lib/nutrition/catalog/
COPY frontend/src/lib/nutrition/validate.js frontend/src/lib/nutrition/persistence-contract.js ./frontend/src/lib/nutrition/
COPY api/nutrition/core ./api/nutrition/core
COPY api/shared/sha256.js ./api/shared/
RUN mkdir -p scripts/nutrition-local-catalog/artifacts \
 && printf '%s\n' '{"type":"module"}' > package.json
USER 65534:65534
CMD ["node", "scripts/nutrition-local-catalog/worker-benchmark.mjs", "trial", "10"]
